# Copy to .env and fill in. NEVER commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://sirjohn:change-me@localhost:5432/sirjohn?schema=public"

# API port
PORT=4000

# Frontend URL(s) allowed by CORS (comma-separated)
FRONTEND_URL=http://localhost:3000

# JWT: use a long random string, e.g. run: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# First admin account, created by `npm run prisma:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to "true" to expose Swagger docs in production (/api/docs)
SWAGGER_ENABLED=false
